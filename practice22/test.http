### ============================================
### Тестирование балансировки в Docker
### ============================================

@base_url = http://localhost

### 1. Проверка основного эндпоинта (порт 80)
# Выполните несколько раз для проверки балансировки
GET {{base_url}}/
Accept: application/json

### 2. Health check бэкендов через Nginx
GET {{base_url}}/api/health
Accept: application/json

### 3. Список пользователей
GET {{base_url}}/api/users
Accept: application/json

### 4. Список товаров
GET {{base_url}}/api/products
Accept: application/json

### 5. Информация о сервере
GET {{base_url}}/api/info
Accept: application/json

### 6. Нагрузочный тест
GET {{base_url}}/api/load-test?n=5000000
Accept: application/json

### 7. Health check Nginx
GET {{base_url}}/nginx-health

### ============================================
### Тестирование разных алгоритмов
### ============================================

### 8. Round Robin (порт 8001)
GET http://localhost:8001/
Accept: application/json

### 9. Least Connections (порт 8002)
GET http://localhost:8002/
Accept: application/json

### 10. IP Hash (порт 8003)
# С одного IP всегда будет попадать на один сервер
GET http://localhost:8003/
Accept: application/json

### ============================================
### Массовое тестирование (выполните в терминале)
### ============================================

# Проверка распределения (выполнить несколько раз):
# curl -s http://localhost/ | jq .server

# Или скриптом:
# for i in {1..10}; do curl -s http://localhost/ | jq -r '.server'; done