### ============================================
### Тестирование балансировки через Nginx
### ============================================

@nginx_url = http://localhost

### 1. Тестирование Round Robin (основной порт 80)
# Выполните несколько раз и следите за заголовком X-Backend-Server
GET {{nginx_url}}/api/health
Accept: application/json

### 2. Получение списка пользователей
GET {{nginx_url}}/api/users
Accept: application/json

### 3. Получение списка товаров
GET {{nginx_url}}/api/products
Accept: application/json

### 4. Информация о сервере
GET {{nginx_url}}/api/info
Accept: application/json

### 5. Health check Nginx
GET {{nginx_url}}/nginx-health

### ============================================
### Тестирование разных алгоритмов Nginx
### ============================================

### 6. Round Robin (порт 8001)
GET http://localhost:8001/api/health

### 7. Least Connections (порт 8002)
GET http://localhost:8002/api/health

### 8. IP Hash (порт 8003)
# С одного IP всегда будет попадать на один сервер
GET http://localhost:8003/api/health

### ============================================
### Тестирование через HAProxy
### ============================================

### 9. Round Robin через HAProxy (порт 8080)
GET http://localhost:8080/api/health

### 10. Least Connections через HAProxy (порт 8081)
GET http://localhost:8081/api/health

### 11. Source IP Hash через HAProxy (порт 8082)
GET http://localhost:8082/api/health

### 12. Статистика HAProxy
GET http://localhost:8404/
# Логин: admin, пароль: admin123

### ============================================
### Тестирование отказоустойчивости
### ============================================

### 13. Нагрузочный тест
GET {{nginx_url}}/api/load-test?n=5000000

### 14. Многократные запросы для проверки распределения
# Выполнить 10 раз
GET {{nginx_url}}/api/health

### ============================================
### Скрипт для тестирования в терминале
### ============================================

# Запустите в терминале для проверки распределения:
# for i in {1..20}; do curl -s http://localhost/api/health | jq .server; done